LAYER_ADDRESSES    = "Adresses"
LAYER_BUILDINGS    = "Edifications"
LAYER_MDS          = "MDS"
Z_FIELD            = "Z"
IDW_POWER          = 1
PIXEL_SIZE         = 0.1
MARGIN             = 5
REPRESENTATIVE_DAYS = [15, 46, 74, 105, 135, 166, 196, 227, 258, 288, 319, 349]
STEP               = 0.5
LINKE              = 3.0
